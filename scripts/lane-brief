#!/usr/bin/env bash
# lane-brief [id]  — everything you need to pick a lane back up, no model involved.
source "$(python3 -c 'import os,sys;print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")/lib.sh"
id="${1:-}"; [ -z "$id" ] && id=$(python3 -c "import os;p=os.path.realpath('$PWD');w='$LANES/';print(p[len(w):].split('/')[0] if p.startswith(w) else '')")
[ -n "$id" ] && [ -f "$(lane_file "$id")" ] || die "usage: lane-brief <id>  (or run inside lanes/<id>/…)"
f=$(lane_file "$id")
echo "━━ $id  [$(lane_get "$id" status)]  ticket: $(lane_get "$id" ticket)  updated: $(lane_get "$id" updated)"
echo "GOAL"; sed -n '/^## Goal/,/^## Resume note/p' "$f" | sed '1d;$d' | grep -v '^$' | sed 's/^/  /'
echo "RESUME NOTE"; sed -n '/^## Resume note/,/^## /{/^## Resume note/d;/^## /d;p;}' "$f" | grep -v '^$' | sed 's/^/  /'
while read -r repo branch; do d="$LANES/$id/$repo"
  echo "REPO $repo @ $branch"
  if [ -d "$d" ]; then
    echo "  worktree: $d"; echo "  dirty: $(git -C "$d" status --porcelain | wc -l | tr -d ' ')   unpushed: $(git -C "$d" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 'no upstream')"
    git -C "$d" log --oneline -5 | sed 's/^/  /'
    [ -n "$(git -C "$d" status --porcelain)" ] && git -C "$d" status --short | head -10 | sed 's/^/  /'
  else echo "  no worktree (lane-resume $id recreates it)"; fi
  m="$AD/memory/$repo/MEMORY.md"; [ -f "$m" ] && { echo "  memory index ($m):"; { grep '^- ' "$m" || true; } | head -8 | cut -c1-140 | sed 's/^/    /'; }
done < <(lane_repos "$id")
if sed -n '/^## Findings/,/^## Log/p' "$f" | grep -q '^- '; then echo "FINDINGS (live only — archived when this lane finishes)"; sed -n '/^## Findings/,/^## Log/p' "$f" | grep '^- ' | cut -c1-150 | sed 's/^/  /'; fi
if grep -q '^  - path: ' "$f"; then echo "REFERENCES (lanes/$id/refs/)"; "$AD/bin/lane-ref" "$id" list 2>/dev/null | grep -v '^ref'; fi
echo "LOG (last 5)"; sed -n '/^## Log/,$p' "$f" | { grep '^- ' || true; } | tail -5 | sed 's/^/  /'
exit 0
