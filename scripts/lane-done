#!/usr/bin/env bash
# lane-done <id> [--delete-branches] [--delete-sessions|--keep-sessions]: requires clean, pushed
# worktrees. Removes worktrees, archives the file, and asks what to do with each repo's leftover
# Claude session folder (see registry/config.yml `lanes: delete_sessions_on_done:` for the default).
source "$(python3 -c 'import os,sys;print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")/lib.sh"
id="${1:-}"; f=$(lane_file "$id"); [ -f "$f" ] || die "no lane '$id'"
shift || true
DELETE_BRANCHES=0; SESSIONS_MODE=""   # SESSIONS_MODE: "" (ask/report) | delete | keep
for a in "$@"; do
  case "$a" in
    --delete-branches) DELETE_BRANCHES=1 ;;
    --delete-sessions) SESSIONS_MODE=delete ;;
    --keep-sessions) SESSIONS_MODE=keep ;;
    *) die "lane done: unknown option $a" ;;
  esac
done
# The README tells you to work from inside the lane, so the folder being removed below is
# very often the current directory. Step out first: otherwise every later command prints
# `getcwd: cannot access parent directories`, which reads like something went wrong.
cd "$AD" || exit 1
# Check EVERY repo before touching ANY of them. Checking and removing in the same pass meant a
# lane whose second repo had unpushed work lost the first repo's worktree before failing.
problems=""
while read -r repo branch; do d="$LANES/$id/$repo"
  if [ ! -d "$d" ]; then
    # The folder is gone, so we cannot check whether its branch was pushed. Skipping it is how a
    # lane got archived with unpushed commits still on a branch nobody could see.
    if git -C "$REPOS/$repo" rev-parse -q --verify "refs/heads/$branch" >/dev/null 2>&1; then
      up="refs/remotes/origin/$branch"
      if ! git -C "$REPOS/$repo" rev-parse -q --verify "$up" >/dev/null 2>&1 \
         || [ -n "$(git -C "$REPOS/$repo" log --oneline "$up..refs/heads/$branch" 2>/dev/null)" ]; then
        problems="$problems\n  $repo/$branch: the worktree is missing and the branch is not fully pushed — lane resume $id first"
      fi
    fi
    continue
  fi
  [ -z "$(git -C "$d" status --porcelain)" ] || problems="$problems\n  $repo is dirty — commit it, or lane park first"
  if ! git -C "$d" rev-parse -q --verify '@{u}' >/dev/null 2>&1; then
    problems="$problems\n  $repo/$branch was never pushed — push it, or delete the branch first"
  elif [ -n "$(git -C "$d" log --oneline '@{u}..HEAD')" ]; then
    n=$(git -C "$d" rev-list --count '@{u}..HEAD')
    problems="$problems\n  $repo/$branch has $n unpushed commit(s)"
  fi
done < <(lane_repos "$id")
if [ -n "$problems" ]; then
  printf 'not finishing %s — nothing was removed:%b\n' "$id" "$problems" >&2
  exit 1
fi

# default answer for the interactive session-cleanup prompt below — config only ever changes
# which way the prompt defaults, never whether it is asked
CFG_DELETE=$(sed -n 's/^[[:space:]]*delete_sessions_on_done:[[:space:]]*//p' "$AD/registry/config.yml" 2>/dev/null | head -1 | tr -d '"'"'"' ')
[ "$CFG_DELETE" = "true" ] || CFG_DELETE="false"

# everything checked out; now it is safe to remove
# fd 3 holds the real stdin: the loop below redirects its own stdin from lane_repos's output
# (`< <(...)`), so a `read` for the session-delete prompt inside it must not use fd 0 — it would
# read lane_repos's output instead of whatever the terminal (or pipe) actually sent.
exec 3<&0
while read -r repo branch; do d="$LANES/$id/$repo"; [ -d "$d" ] || continue
  git -C "$REPOS/$repo" worktree remove "$d" && echo "removed worktree $d"
  [ "$DELETE_BRANCHES" = 1 ] && git -C "$REPOS/$repo" branch -D "$branch" && echo "deleted branch $branch"

  sdir="$HOME/.claude/projects/$(claude_project_dir "$d")"
  sn=0; [ -d "$sdir" ] && sn=$(ls "$sdir"/*.jsonl 2>/dev/null | wc -l | tr -d ' ')
  if [ "$sn" -gt 0 ] 2>/dev/null; then
    case "$SESSIONS_MODE" in
      delete) rm -rf "$sdir"; echo "deleted $sn session(s) for $repo" ;;
      keep)   echo "kept $sn session(s) for $repo" ;;
      "")
        if [ -t 3 ] && [ -t 2 ]; then
          if [ "$CFG_DELETE" = "true" ]; then
            printf "  %s session(s) exist for %s in this lane. Delete them? [Y/n]: " "$sn" "$repo" >&2
            read -r yn <&3 || true; case "${yn:-y}" in [nN]*) yn=n ;; *) yn=y ;; esac
          else
            printf "  %s session(s) exist for %s in this lane. Delete them? [y/N]: " "$sn" "$repo" >&2
            read -r yn <&3 || true; case "${yn:-n}" in [yY]*) yn=y ;; *) yn=n ;; esac
          fi
          if [ "$yn" = y ]; then rm -rf "$sdir"; echo "deleted $sn session(s) for $repo"
          else echo "kept $sn session(s) for $repo"; fi
        else
          # no terminal: an agent-driven `lane done` never deletes session history silently
          echo "$sn session(s) exist for $repo, not touched — no terminal to ask"
        fi
        ;;
    esac
  fi
done < <(lane_repos "$id")
rmdir "$LANES/$id" 2>/dev/null || rm -rf "$LANES/$id"
if sed -n '/^## Findings/,/^## Log/p' "$f" | grep -q '^- '; then
  echo; echo "This lane has findings that will be archived with it:"
  sed -n '/^## Findings/,/^## Log/p' "$f" | grep '^- ' | sed 's/^/   /'
  echo "   Anything still true after this ships belongs in repo memory — lane-memory draft <slug> then lane-memory file <slug> repo <repo>."
fi
lane_set_status "$id" done; mkdir -p "$LANES_DIR/done"; mv "$f" "$LANES_DIR/done/"; "$AD/scripts/lane-workspace" >/dev/null
refresh_guards; echo "done: $id -> registry/lanes/done/"
