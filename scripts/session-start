#!/usr/bin/env bash
# Output: JSON with additionalContext (for Claude) and systemMessage (shown to the owner on the startup screen).
# Set LANE_PLAIN=1 to get the plain text instead (used by the wrapper for terminal printing).
if [ -z "${LANE_PLAIN:-}" ] && [ -z "${_LANE_INNER:-}" ]; then
  input=""; [ -t 0 ] || input=$(cat)
  text=$(printf '%s' "$input" | _LANE_INNER=1 "$0" "$@")
  screen=$(printf '%s' "$input" | _LANE_INNER=1 LANE_SCREEN=1 "$0" "$@")
  python3 -c 'import json,sys; ctx,scr=sys.argv[1],sys.argv[2]; print(json.dumps({"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":ctx},"systemMessage":scr}))' "$text" "$screen"
  exit 0
fi
# SessionStart hook. Reads the hook JSON on stdin (session_id, transcript_path, source, cwd), prints
# context for Claude: the board, the dispatcher procedure, and — for resumed conversations — which repo
# the conversation belongs to and the exact choices to offer the owner before anything else.
source "$(python3 -c 'import os,sys;print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")/lib.sh"
input=""; [ -t 0 ] || input=$(cat)
printf '%s' "$input" > "$AD/.cache/last-session-start.json" 2>/dev/null || true
read -r source sid scwd <<<"$(printf '%s' "$input" | python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: d={}
print(d.get("source","startup"), d.get("session_id","-"), d.get("cwd","-"))' 2>/dev/null || echo "startup - -")"
[ "$scwd" = "-" ] && scwd="$PWD"
# repo the conversation belongs to: the managed-repo project folder that holds <session_id>.jsonl
# (transcript_path in the hook input is derived from cwd, not from where the file lives — do not use it)
repo=""
if [ "$sid" != "-" ]; then
  # the project folder is named after THIS folder's path, so compute it rather than assume it
  slug=$(printf '%s' "$AD" | sed 's#[/_]#-#g')
  f=$(ls "$HOME"/.claude/projects/"$slug"-repos-*/"$sid".jsonl 2>/dev/null | head -1 || true)
  [ -n "$f" ] && { repo=${f#*"$slug"-repos-}; repo=${repo%%/*}; }
fi
cur=$(python3 -c "import os;p=os.path.realpath('$scwd');w='$LANES/';print(p[len(w):].split('/')[0] if p.startswith(w) else '')")

# ---- human screen (systemMessage) -------------------------------------------------------------
if [ -n "${LANE_SCREEN:-}" ]; then
  if [ -n "$cur" ] && [ -f "$(lane_file "$cur")" ]; then
    "$AD/scripts/lane-brief" "$cur" 2>/dev/null
    echo; echo "commands: ! lane-menu   (prefix any lane-* command with \"! \" to run it here without a model call)"
  else
    echo "LANES"
    for f in "$LANES_DIR"/*.md; do [ -f "$f" ] || continue; id=$(basename "$f" .md); st=$(lane_get "$id" status)
      line="  $id  [$st]"
      while read -r r branch; do d="$LANES/$id/$r"
        if [ -d "$d" ]; then line="$line  $r ↑$(git -C "$d" rev-list --count '@{u}..HEAD' 2>/dev/null || echo '?') ✎$(git -C "$d" status --porcelain | wc -l | tr -d ' ')"; else line="$line  $r (no worktree)"; fi
      done < <(lane_repos "$id")
      echo "$line"
    done
    [ "$source" = "resume" ] && [ -n "$repo" ] && echo && echo "RESUMED conversation belongs to: $repo — Claude will offer where to continue."
    echo; "$AD/scripts/menu"
  fi
  exit 0
fi

if [ "$source" = "resume" ] && [ -n "$repo" ]; then
  echo "## RESUMED CONVERSATION — it belongs to repo '$repo' (transcript lives in that repo's project folder)."
  echo "Its earlier turns refer to OLD checkout paths. Those copies are frozen and blocked. Translate every mention:"
  echo "    old path in the transcript                                   -> what it means now"
  python3 - "$repo" "$LANES" <<'PY'
import json,sys,os,glob
repo,LANES=sys.argv[1:]
AD=os.path.dirname(LANES)
olds=[k for k in json.load(open(f"{AD}/registry/old-checkouts.json")) if k.rstrip("/").endswith("/"+repo)]
wts=sorted(glob.glob(f"{LANES}/*/{repo}"))
target=(wts[0] if len(wts)==1 else ("lanes/<id>/"+repo+" (the lane you enter)")).replace(AD+"/","")
for o in olds: print(f"    {o:60} -> {target}")
print(f"    {'repos/'+repo+' (mirror)':60} -> not a place to work; never mention it")
PY
  echo "When you report state, use only the STATE block that arrives with each prompt. Never compare against old copies."
  wts=$(ls -d "$LANES"/*/"$repo" 2>/dev/null | sed "s|$LANES/||; s|/$repo||" || true)
  if [ -n "$cur" ]; then
    if [ -d "$LANES/$cur/$repo" ]; then echo "You are already inside lane '$cur', which has this repo. Re-anchor every path to $LANES/$cur/$repo and continue."
    else echo "WARNING: you are inside lane '$cur' but it has no worktree for '$repo'. Offer: scripts/lane-add $cur $repo, or switch lane."; fi
  else
    echo
    echo "YOUR FIRST MESSAGE, before answering anything else, must say which repo this is and offer these choices:"
    if [ -n "$wts" ]; then for w in $wts; do echo "  - continue in existing lane '$w' → EnterWorktree path=$LANES/$w/$repo  (status: $(lane_get "$w" status); note: $(sed -n '/^## Resume note/,/^## Log/p' "$(lane_file "$w")" | sed '1d;$d' | grep -v '^$' | head -1 | cut -c1-120))"; done; fi
    echo "  - start a NEW lane for it → ask for a short id (ticket key or slug), then EnterWorktree name=<id>/$repo, then write its Goal from this conversation"
    echo "  - read-only: just answer questions, no worktree"
    echo "Recommend one and WAIT for his answer. Even if his message is a concrete request, do not enter or create a worktree until he has chosen."
  fi
  echo
fi

if [ "${1:-}" = "--worktree" ] || [ -n "$cur" ]; then
  id="$cur"
  if [ -n "$id" ] && [ -f "$(lane_file "$id")" ]; then
    echo "## lane — session in lane '$id' ($(basename "$scwd"))"; echo
    cat "$(lane_file "$id")"; echo
    echo "Read memory/<repo>/MEMORY.md for each repo above, then brief $OWNER in five lines and continue the work."
    echo "Scope: only lanes/$id/. Park with scripts/lane-park $id \"<note>\" before they switch away."
  fi
  exit 0
fi

echo "## lane dispatcher — board at $(date '+%F %H:%M')"
echo
for f in "$LANES_DIR"/*.md; do [ -f "$f" ] || continue; id=$(basename "$f" .md)
  st=$(lane_get "$id" status); up=$(lane_get "$id" updated)
  line="- **$id** [$st, updated $up]"
  while read -r r branch; do d="$LANES/$id/$r"
    if [ -d "$d" ]; then line="$line · $r/$branch ($(git -C "$d" status --porcelain | wc -l | tr -d ' ') dirty, $(git -C "$d" log --oneline '@{u}..HEAD' 2>/dev/null | wc -l | tr -d ' ') unpushed)"
    else line="$line · $r/$branch (no worktree yet)"; fi
  done < <(lane_repos "$id")
  echo "$line"
  note=$(sed -n '/^## Resume note/,/^## Log/p' "$f" | sed '1d;$d' | grep -v '^$' | head -1 | cut -c1-160)
  [ -n "$note" ] && echo "    $note"
done
echo
echo "Repos: $(ls "$REPOS" | tr '\n' ' ')"
echo
cat <<'TXT'
Dispatcher instructions (details in CLAUDE.md "Dispatcher mode"):
- Discuss before deciding: propose ids, repos, branches, deletions, global-config changes and design choices in one
  line with a recommendation, then wait. Run directly only mechanical, reversible, explicitly requested steps.
- Be a visible operator: every time you run a lane-* script, enter or leave a worktree, or change a lane file,
  say so in one line. Never do these silently.
- Fresh session: list the active lanes above, one line each, and ask which one or what new work to start.
- Resume: scripts/lane-resume <id>, then EnterWorktree path=<AD>/lanes/<id>/<repo>.  New: EnterWorktree name="<id>/<repo>".
- Add repo to lane: scripts/lane-add. New repo under management: scripts/repo-add. Old chats: scripts/sessions <repo>,
  then hand over `claude --resume <session-id>` (any folder); they cannot be switched into mid-session.
- Leave: scripts/lane-park <id> "<note>" then ExitWorktree keep.
- If asked what he can do, show the menu below verbatim.
TXT
"$AD/scripts/menu"
