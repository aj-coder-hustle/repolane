#!/usr/bin/env bash
# repo-secrets <repo> scan|add|list [<path-or-glob>...]
# guard.py already denies a fixed, global set of secret-shaped filenames (.env*, *.pem/*.key,
# *credentials*.json, secrets.json/yaml/toml) for every repo. That set cannot grow to cover every
# company's own naming (service-account.json, .npmrc, id_rsa, .aws/credentials, apikey.txt) without
# becoming unbounded, so per-repo names are declared instead, as deny rules in registry/rules.yaml —
# the same gitignored, deny-only extension point documented in docs/rules.md#rules-of-your-own.
#
#   repo-secrets scan <repo>                        candidate filenames, one per line, by name only
#   repo-secrets add <repo> <path-or-glob>...        write deny rules for each path into rules.yaml
#   repo-secrets list <repo>                         paths already declared for this repo
source "$(python3 -c 'import os,sys;print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")/lib.sh"

sub="${1:-}"; repo="${2:-}"
[ -n "$sub" ] && [ -n "$repo" ] || die "usage: repo-secrets scan|add|list <repo> [<path-or-glob>...]"
repo_exists "$repo"
shift 2
RULES="$AD/registry/rules.yaml"

# Filename shapes the built-in guard does NOT already cover — no point declaring what is already
# denied everywhere. Case-insensitive, filename-only: this never reads what is inside a file.
CANDIDATE_RE='(^|/)(\.npmrc|\.netrc|id_rsa[^/]*|id_ed25519[^/]*|id_ecdsa[^/]*|[^/]*\.(keystore|jks)|service[-_]?account[^/]*\.json|[^/]*credentials[^/]*|[^/]*api[-_]?key[^/]*|[^/]*password[^/]*|[^/]*token[^/]*|\.aws/[^/]*|\.ssh/id_[^/]*)$'

case "$sub" in
  scan)
    repo_dir="$REPOS/$repo"
    { git -C "$repo_dir" ls-files
      git -C "$repo_dir" status --porcelain --ignored -z | tr '\0' '\n' | sed -n 's/^!! //p'
    } | { grep -iE "$CANDIDATE_RE" || true; } | sort -u
    ;;

  list)
    [ -f "$RULES" ] || exit 0
    # the -read rule of each declared pattern carries `when: { tool: Read, path: "<path>" }`;
    # pull the path out of just those, so a pattern declared once shows once, not six times
    { grep -A1 "^  - id: secret-$repo-[0-9]*-read\$" "$RULES" 2>/dev/null || true; } \
      | sed -n 's/.*path: "\(.*\)" }.*/\1/p' | sort -u
    ;;

  add)
    [ $# -gt 0 ] || die "usage: repo-secrets add <repo> <path-or-glob> [<path-or-glob>...]"
    if [ ! -f "$RULES" ]; then
      cat > "$RULES" <<'EOT'
# This control plane's own rules, on top of the ones guard.py ships with. Deny-only, checked
# before the built-ins. It is gitignored — see docs/rules.md#rules-of-your-own.
rules:
EOT
    fi
    # continue the per-repo counter past whatever is already declared, so re-running `add` never
    # collides with existing rule ids
    n=$(grep -oE "id: secret-$repo-[0-9]+-read" "$RULES" 2>/dev/null | grep -oE '[0-9]+' | sort -n | tail -1) || true
    n=${n:-0}
    for path in "$@"; do
      if grep -qF "\"$path\"" "$RULES" 2>/dev/null || grep -qE "path: '?${path//\//\\/}'?" "$RULES" 2>/dev/null; then
        echo "  already declared, skipping: $path"
        continue
      fi
      n=$((n+1))
      ref="memory/$repo/MEMORY.md"
      # a literal (regex-escaped) substring of the path, for the Bash `matches` rule
      esc=$(python3 -c 'import re,sys;print(re.escape(sys.argv[1]))' "$path")
      {
        printf '  - id: secret-%s-%s-read\n' "$repo" "$n"
        printf '    when: { tool: Read, path: "%s" }\n' "$path"
        printf '    deny: "%s was declared a secret/credential file for this repo (registry/rules.yaml)."\n' "$path"
        printf '    ref: %s\n' "$ref"
        printf '    example: { path: "repos/%s/%s" }\n\n' "$repo" "$path"

        printf '  - id: secret-%s-%s-edit\n' "$repo" "$n"
        printf '    when: { tool: Edit, path: "%s" }\n' "$path"
        printf '    deny: "%s was declared a secret/credential file for this repo (registry/rules.yaml)."\n' "$path"
        printf '    ref: %s\n' "$ref"
        printf '    example: { path: "repos/%s/%s" }\n\n' "$repo" "$path"

        printf '  - id: secret-%s-%s-write\n' "$repo" "$n"
        printf '    when: { tool: Write, path: "%s" }\n' "$path"
        printf '    deny: "%s was declared a secret/credential file for this repo (registry/rules.yaml)."\n' "$path"
        printf '    ref: %s\n' "$ref"
        printf '    example: { path: "repos/%s/%s" }\n\n' "$repo" "$path"

        printf '  - id: secret-%s-%s-multiedit\n' "$repo" "$n"
        printf '    when: { tool: MultiEdit, path: "%s" }\n' "$path"
        printf '    deny: "%s was declared a secret/credential file for this repo (registry/rules.yaml)."\n' "$path"
        printf '    ref: %s\n' "$ref"
        printf '    example: { path: "repos/%s/%s" }\n\n' "$repo" "$path"

        printf '  - id: secret-%s-%s-notebookedit\n' "$repo" "$n"
        printf '    when: { tool: NotebookEdit, path: "%s" }\n' "$path"
        printf '    deny: "%s was declared a secret/credential file for this repo (registry/rules.yaml)."\n' "$path"
        printf '    ref: %s\n' "$ref"
        printf '    example: { path: "repos/%s/%s" }\n\n' "$repo" "$path"

        printf '  - id: secret-%s-%s-bash\n' "$repo" "$n"
        printf '    when: { tool: Bash, matches: '"'"'%s'"'"' }\n' "$esc"
        printf '    deny: "%s was declared a secret/credential file for this repo (registry/rules.yaml)."\n' "$path"
        printf '    ref: %s\n' "$ref"
        printf '    example: "cat repos/%s/%s"\n\n' "$repo" "$path"
      } >> "$RULES"
      echo "  declared secret: $path"
    done
    ;;

  *) die "usage: repo-secrets scan|add|list <repo> [<path-or-glob>...]" ;;
esac
